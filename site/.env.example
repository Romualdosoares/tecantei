# Supabase — valores públicos permitidos no navegador
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Supabase — somente servidor; nunca prefixar com NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA
SUPABASE_AUDIO_BUCKET=te-cantei-audio

# Criação da letra — GPT via Kie.ai; chave pode ser cadastrada no painel.
LYRICS_GENERATION_MODE=mock
KIE_LIVE_LYRICS_ENABLED=false
KIE_LYRICS_MODEL=gpt-5-6-terra

# Kie.ai — somente servidor
KIE_API_KEY=SUBSTITUA
KIE_WEBHOOK_HMAC_KEY=SUBSTITUA
KIE_ALLOWED_AUDIO_HOSTS=cdn1.exemplo.com,cdn2.exemplo.com
KIE_MODEL=V6
KIE_GENERATION_MODE=mock
KIE_LIVE_GENERATION_ENABLED=false
KIE_GENERATION_CREDITS=12

# Orçamento móvel de 24h; os dois valores são obrigatórios somente no modo live
GENERATION_BUDGET_SCOPE=local
GENERATION_ACCOUNT_24H_CREDITS=SUBSTITUA_NO_LIVE
GENERATION_ENVIRONMENT_24H_CREDITS=SUBSTITUA_NO_LIVE

# Executor interno da fila; use valor aleatório com pelo menos 24 caracteres
CRON_SECRET=SUBSTITUA_POR_UM_SEGREDO_LONGO

# Pagamento permanece simulado até conectar as rotas persistentes do provedor
PAYMENT_MODE=mock
PAYMENT_LIVE_ENABLED=false
PAYMENT_MOCK_CONFIRMATION_ENABLED=false
PAYMENT_PROVIDER=mercado_pago

# Mercado Pago — somente servidor
MERCADO_PAGO_ACCESS_TOKEN=SUBSTITUA_NO_LIVE
MERCADO_PAGO_WEBHOOK_SECRET=SUBSTITUA_NO_LIVE

# Efí Pix — somente servidor; o certificado P12 deve estar codificado em base64
EFI_ENVIRONMENT=homologation
EFI_CLIENT_ID=SUBSTITUA_NO_LIVE
EFI_CLIENT_SECRET=SUBSTITUA_NO_LIVE
EFI_PIX_KEY=SUBSTITUA_NO_LIVE
EFI_CERTIFICATE_P12_BASE64=SUBSTITUA_NO_LIVE
EFI_CERTIFICATE_PASSPHRASE=
EFI_WEBHOOK_TOKEN=SUBSTITUA_NO_LIVE
EFI_WEBHOOK_MTLS_TERMINATION=unconfigured
EFI_WEBHOOK_MTLS_GATEWAY_SECRET=SUBSTITUA_NO_LIVE

# URL canônica por ambiente (local, preview ou produção)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
